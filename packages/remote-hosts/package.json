{
  "name": "@cryptocurpays/dsh-remote-hosts",
  "description": "Remote host discovery seam (ctx.remoteHosts): resolve host references to connection specs via replaceable providers",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptocurpays/dsh-remote-tools.git",
    "directory": "packages/remote-hosts"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*"
  }
}
