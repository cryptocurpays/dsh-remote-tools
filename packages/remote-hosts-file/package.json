{
  "name": "@cryptocurpays/dsh-remote-hosts-file",
  "description": "File-backed discovery provider for ctx.remoteHosts: static test servers listed in a YAML document (name, host, port, username, tokenRef) become resolvable host references",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@cryptocurpays/dsh-remote-hosts": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@cryptocurpays/dsh-remote-hosts": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
