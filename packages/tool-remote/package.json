{
  "name": "@zealousw/dsh-tool-remote",
  "description": "Model-facing remote host tools: search discovery providers, open persistent ssh sessions, and run one-shot remote commands",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptocurpays/dsh-remote-tools.git",
    "directory": "packages/tool-remote"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs"
  },
  "peerDependencies": {
    "@zealousw/dsh-remote-hosts": "^0.1.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-terminal": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
