{
  "name": "@zealousw/dsh-remote-tools",
  "version": "0.1.0",
  "description": "Out-of-tree dsh bundle: remote-host discovery (JumpServer + file providers), an SSH terminal backend, and model-facing remote tools",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptocurpays/dsh-remote-tools.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-packages.mjs",
    "prepare": "node scripts/build-packages.mjs",
    "prepublishOnly": "node scripts/build-packages.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@zealousw/dsh-remote-hosts": "workspace:*",
    "@zealousw/dsh-remote-hosts-file": "workspace:*",
    "@zealousw/dsh-remote-hosts-jumpserver": "workspace:*",
    "@zealousw/dsh-terminal-ssh": "workspace:*",
    "@zealousw/dsh-tool-remote": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
